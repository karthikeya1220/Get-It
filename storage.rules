rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Client uploads from the interview analyzer (lib/firebase-service.ts).
    match /videos/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }

    // Server-side uploads (/api/upload-video via Admin SDK). Clients never write;
    // only the uploader may read them back.
    match /uploads/{uid}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Everything else is off-limits.
  }
}
