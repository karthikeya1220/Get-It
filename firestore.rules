rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Credentials live in Firebase Auth, and the role must not be
    // self-assigned after the profile has been created.
    function noCredentialOrRoleChange() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['password', 'Role']);
    }

    // `resource` does not exist on create, so the update guards above cannot be
    // reused — without this a client could DELETE its profile and re-CREATE it
    // with verified:true to skip the payment flow.
    function createdDocIsSafe() {
      return !request.resource.data.keys().hasAny(['password', 'confirmPassword'])
        && request.resource.data.get('verified', false) != true
        && request.resource.data.get('Verified', false) != true
        && request.resource.data.get('Role', 'student') in
           ['student', 'recruiter', 'Student', 'Recruiter'];
    }

    // Role custom claim, minted server-side by POST /api/auth/session.
    // `roleUnknown()` keeps sessions issued before this change working; the
    // claim lands on the next token refresh either way.
    function hasRole(r) {
      return request.auth.token.get('role', '') == r;
    }

    function roleUnknown() {
      return request.auth.token.get('role', '') == '';
    }

    // `verified` may only ever be granted by the Admin SDK (payment API /
    // webhook), which bypasses these rules. Clients may set it to false
    // (profile bootstrap) but must never turn it on.
    function verifiedNotGranted() {
      return (request.resource.data.get('verified', false) != true
              || resource.data.get('verified', false) == true)
          && (request.resource.data.get('Verified', false) != true
              || resource.data.get('Verified', false) == true);
    }

    function canEditOwnProfile() {
      return noCredentialOrRoleChange() && verifiedNotGranted();
    }

    // ── Users ────────────────────────────────────────────────────────────────
    // Legacy/flat doc: users/{uid}
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid) && createdDocIsSafe();
      allow update: if isOwner(uid) && canEditOwnProfile();
      allow delete: if isOwner(uid);
    }

    // Role docs: users/student/{uid}/user_details, users/recruiter/{uid}/user_details
    match /users/{role}/{uid}/user_details {
      allow read: if signedIn();
      allow create: if isOwner(uid) && role in ['student', 'recruiter']
                    && createdDocIsSafe();
      allow update: if isOwner(uid) && canEditOwnProfile();
      allow delete: if isOwner(uid);
    }

    // Per-user subcollections: users/{uid}/interview_analyses/{id}
    match /users/{uid}/{subcollection}/{docId} {
      allow read, write: if isOwner(uid);
    }

    // Fallback profile paths still present in existing data
    match /students/{uid} {
      allow read: if signedIn();
      allow write: if isOwner(uid) && canEditOwnProfile();
    }
    match /recruiters/{uid} {
      allow read: if signedIn();
      allow write: if isOwner(uid) && canEditOwnProfile();
    }

    // ── Jobs ─────────────────────────────────────────────────────────────────
    match /jobs/{jobId} {
      // The poster has full control...
      allow update: if signedIn() && (
        resource.data.get('postedBy', '') == request.auth.uid
        // ...everyone else may only append themselves to `applicants`.
        || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['applicants', 'updatedAt'])
          && request.resource.data.get('applicants', []).size()
             == resource.data.get('applicants', []).size() + 1
          && request.resource.data.get('applicants', []).hasAll(resource.data.get('applicants', []))
          && request.auth.uid in request.resource.data.get('applicants', [])
        )
      );

      allow read: if signedIn();
      // Job posting is a recruiter capability (UI only exposes it there).
      allow create: if signedIn()
        && request.resource.data.postedBy == request.auth.uid
        && (roleUnknown() || hasRole('recruiter'));
      allow delete: if signedIn() && resource.data.get('postedBy', '') == request.auth.uid;
    }

    // ── Applications ─────────────────────────────────────────────────────────
    match /applications/{applicationId} {
      function job() {
        return get(/databases/$(database)/documents/jobs/$(resource.data.jobId));
      }
      function jobPoster() {
        return job().exists ? job().data.get('postedBy', '') : '';
      }

      allow read: if signedIn() &&
        (resource.data.studentId == request.auth.uid || jobPoster() == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid
        && jobPoster() != request.auth.uid
        && (roleUnknown() || hasRole('student'));

      // The student may edit their own application without touching the status;
      // the recruiter who posted the job owns status transitions.
      allow update: if signedIn() && (
        (resource.data.studentId == request.auth.uid
          && request.resource.data.status == resource.data.status
          && canEditOwnProfile())
        || jobPoster() == request.auth.uid
      );

      allow delete: if signedIn() && resource.data.studentId == request.auth.uid;
    }

    // ── Feed posts ─────────────────────────────────────────────────────────
    // Only the author may change the body. Signed-in strangers may touch the
    // engagement counters, and only in the exact shape of a like/share/comment
    // delta, so nobody can hand themselves a thousand likes.
    match /posts/{postId} {
      function affected(keys) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
      }

      function likeAdded() {
        return affected(['likeCount', 'likedBy', 'engagement'])
          && request.resource.data.get('likeCount', 0) == resource.data.get('likeCount', 0) + 1
          && request.resource.data.get('likedBy', []).size()
             == resource.data.get('likedBy', []).size() + 1
          && request.resource.data.get('likedBy', []).hasAll(resource.data.get('likedBy', []))
          && request.auth.uid in request.resource.data.get('likedBy', []);
      }

      function likeRemoved() {
        return affected(['likeCount', 'likedBy', 'engagement'])
          && request.resource.data.get('likeCount', 0) == resource.data.get('likeCount', 0) - 1
          && request.resource.data.get('likedBy', []).size()
             == resource.data.get('likedBy', []).size() - 1
          && resource.data.get('likedBy', []).hasAll(request.resource.data.get('likedBy', []))
          && request.auth.uid in resource.data.get('likedBy', [])
          && !(request.auth.uid in request.resource.data.get('likedBy', []));
      }

      function counterBumped(field) {
        return affected([field, 'engagement'])
          && request.resource.data.get(field, 0) == resource.data.get(field, 0) + 1;
      }

      function counterDropped(field) {
        return affected([field, 'engagement'])
          && request.resource.data.get(field, 0) == resource.data.get(field, 0) - 1;
      }

      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.get('likeCount', 0) == 0
        && request.resource.data.get('commentCount', 0) == 0
        && request.resource.data.get('shareCount', 0) == 0
        && request.resource.data.get('engagement', 0) == 0
        && request.resource.data.get('likedBy', []).size() == 0;

      allow update: if signedIn() && (
        (resource.data.get('authorId', '') == request.auth.uid
          && affected(['content', 'image', 'imageAlt', 'updatedAt']))
        || likeAdded()
        || likeRemoved()
        || counterBumped('commentCount')
        || counterDropped('commentCount')
        || counterBumped('shareCount')
      );

      allow delete: if signedIn() && resource.data.get('authorId', '') == request.auth.uid;
    }

    match /posts/{postId}/comments/{commentId} {
      function affected(keys) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
      }

      function commentLikeAdded() {
        return affected(['likeCount', 'likedBy'])
          && request.resource.data.get('likeCount', 0) == resource.data.get('likeCount', 0) + 1
          && request.resource.data.get('likedBy', []).size()
             == resource.data.get('likedBy', []).size() + 1
          && request.resource.data.get('likedBy', []).hasAll(resource.data.get('likedBy', []))
          && request.auth.uid in request.resource.data.get('likedBy', []);
      }

      function commentLikeRemoved() {
        return affected(['likeCount', 'likedBy'])
          && request.resource.data.get('likeCount', 0) == resource.data.get('likeCount', 0) - 1
          && request.resource.data.get('likedBy', []).size()
             == resource.data.get('likedBy', []).size() - 1
          && resource.data.get('likedBy', []).hasAll(request.resource.data.get('likedBy', []))
          && request.auth.uid in resource.data.get('likedBy', [])
          && !(request.auth.uid in request.resource.data.get('likedBy', []));
      }

      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.get('likeCount', 0) == 0
        && request.resource.data.get('likedBy', []).size() == 0;

      allow update: if signedIn() && (
        (resource.data.get('authorId', '') == request.auth.uid
          && affected(['content', 'updatedAt']))
        || commentLikeAdded()
        || commentLikeRemoved()
      );

      allow delete: if signedIn() && resource.data.get('authorId', '') == request.auth.uid;
    }

    // ── Payments: server-only. Written by /api/payments/* and the Razorpay
    //    webhook through the Admin SDK, which bypasses these rules. ──────────
    match /payments/{paymentId} {
      allow read, write: if false;
    }
  }
}
